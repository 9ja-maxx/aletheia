# Aletheia Frontend Environment Variables
# Copy this file to .env.local and fill in values before running locally.

# GenLayer StudioNet RPC (default used in contract.ts; override here if needed)
NEXT_PUBLIC_RPC_URL=https://studio.genlayer.com/api

# Deployed Aletheia contract address (update after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT_ADDRESS_HERE
